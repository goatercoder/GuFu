# Required for live mode. SEC EDGAR rejects requests without a descriptive User-Agent.
GUFU_SEC_USER_AGENT="GuFu research app your-name your@email.com"

# Set to 1 to run fully offline on bundled sample data (no SEC / Yahoo calls). Never use for real research.
GUFU_FIXTURE_MODE=0

# Optional tuning
# GUFU_DB_PATH=backend/data/gufu.sqlite
# GUFU_KEEP_RAW_FACTS=1          # keep gzipped raw companyfacts (~1 MB per company) for re-normalising without refetching
# GUFU_SEC_RPS=8                 # SEC allows 10 requests/second
# GUFU_YAHOO_CONCURRENCY=3
# GUFU_AUTO_BUILD_ON_START=1     # build the whole S&P 500 cache on first start
# GUFU_FACTS_MAX_AGE_DAYS=7
# GUFU_PRICES_MAX_AGE_HOURS=24
